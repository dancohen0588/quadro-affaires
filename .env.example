# Quadro Affaires — variables d'environnement
# Copier en .env.local (jamais commité). Détails : docs/demarrage.md, section 5.

# Supabase — projet distant quadro-affaires-demo (eu-west-3)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Côté serveur uniquement : jamais dans un composant client ni une variable NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase CLI (db push, gen types)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Facultatif en local si `supabase login` a été fait
SUPABASE_ACCESS_TOKEN=

# Mode de l'application : demo | production
APP_MODE=demo
# Code d'accès à l'URL de démo (section 5.4)
DEMO_ACCESS_CODE=
# Mot de passe commun des comptes personnages créés par le seed (openssl rand -base64 24)
DEMO_PERSONA_PASSWORD=

# Routes de tâches planifiées (openssl rand -hex 32)
CRON_SECRET=

# Bloc B2 (envoi réel des mails)
RESEND_API_KEY=
